{
  "name": "mcp-dependency-version",
  "version": "1.0.0",
  "exports": "./main.ts",
  "tasks": {
    "start": "deno run --allow-net --allow-env --allow-read main.ts",
    "dev": "deno run --allow-net --allow-env --allow-read --watch main.ts",
    "check": "deno check main.ts",
    "test": "deno test --allow-net --allow-read",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "update-licenses": "deno run --allow-net --allow-read --allow-write=data scripts/update-licenses.ts"
  },
  "imports": {
    "@modelcontextprotocol/sdk": "npm:@modelcontextprotocol/sdk@1.25.3",
    "zod": "npm:zod@3.25.76",
    "@std/assert": "jsr:@std/assert@1.0.17",
    "@std/path": "jsr:@std/path@1.1.4"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true
  }
}
